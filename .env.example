# Canvas API Configuration
CANVAS_API_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=your_api_token_here
CANVAS_COURSE_ID=your_course_id_here
CANVAS_COURSE_NAME=Section 1

# Optional: a second course (e.g. another section of the same class).
# Pass course_id: 2 (or the label below) on any tool call to target it.
# CANVAS_COURSE_ID_2=your_second_course_id_here
# CANVAS_COURSE_NAME_2=Section 2
